  {
   "id": "lib.comics",
   "category": "Biblioteca",
   "title": "Convertir cómics y manga para Kobo",
   "description": "Estilo KCC, ajustado a tu panel: recorta márgenes, divide páginas dobles, ajusta a la resolución exacta, conserva y realza el color en Kaleido 3 y genera KEPUB de página fija (paso de página rápido) o CBZ para KOReader.",
   "risk": "bajo",
   "recommended": false,
   "requires": [],
   "options": [
