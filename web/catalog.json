  {
   "id": "fw.kobopatch",
   "category": "Sistema",
   "title": "Parches de firmware (kobopatch, avanzado)",
   "description": "Modifica Nickel con parches de la comunidad: interlineado y márgenes finos, tamaños de fuente, encabezados limpios, tiempos de suspensión y más. Se pierden al actualizar el firmware. Si algo falla, «Restaurar originales» o reinstalar el firmware lo revierte.",
   "risk": "alto",
   "recommended": false,
   "requires": [],
   "options": [
    {
     "id": "mode",
     "label": "Acción",
     "type": "choice",
     "default": "patch",
     "choices": [
      {
       "value": "patch",
       "label": "Aplicar parches"
      },
      {
       "value": "restore",
       "label": "Restaurar originales"
      }
     ],
     "help": ""
    },
    {
     "id": "patches",
     "label": "Parches",
     "type": "multi",
     "default": [],
     "choices": [
      {
       "value": "src/libnickel.so.1.0.0.yaml::My 10 line spacing values",
       "label": "10 interlineados más finos (My 10 line spacing values)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Custom font sizes",
       "label": "Tamaños de fuente personalizados (Custom font sizes)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Custom left & right margins",
       "label": "Márgenes laterales personalizados (Custom left & right margins)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Force user line spacing in KePubs",
       "label": "Respetar tu interlineado en KePub (Force user line spacing in KePubs)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Remove title from reading header/footer",
       "label": "Quitar el título del encabezado/pie (Remove title from reading header/footer)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Don't uppercase header/footer text",
       "label": "Encabezado/pie sin mayúsculas (Don't uppercase header/footer text)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Larger Sleep/Power-off timeouts",
       "label": "Tiempos de suspensión más largos (Larger Sleep/Power-off timeouts)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Block WiFi firmware upgrade",
       "label": "Bloquear actualización de firmware por WiFi (Block WiFi firmware upgrade)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Both page turn buttons go next",
       "label": "Ambos botones avanzan página (Both page turn buttons go next)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Disable all tutorial dialogs",
       "label": "Desactivar tutoriales (Disable all tutorial dialogs)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Increase page navigation history",
       "label": "Historial de navegación más largo (Increase page navigation history)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Dictionary text font-family/font-size/line-height",
       "label": "Texto del diccionario más legible (Dictionary text font-family/font-size/line-height)"
      },
      {
       "value": "src/libnickel.so.1.0.0.yaml::Allow USB storage even when device locked",
       "label": "USB aunque el lector esté bloqueado (Allow USB storage even when device locked)"
      }
     ],
     "help": ""
